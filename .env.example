# Database
DATABASE_URL=postgresql://user:password@localhost:5432/theusapublishers_dev

# Email Service (Nodemailer + SMTP)
# Use Gmail, Outlook, SendGrid, or any SMTP provider
# Gmail: host=smtp.gmail.com, port=587, use App Password (not regular password)
# Outlook: host=smtp-mail.outlook.com, port=587
# SendGrid: host=smtp.sendgrid.net, port=587, user=apikey
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password-or-smtp-password
ADMIN_EMAIL=support@theusapublishers.com

# Vercel Blob (Optional - for image storage)
BLOB_READ_WRITE_TOKEN=

# App Configuration
NEXT_PUBLIC_APP_NAME=The USA Publishing
NEXT_PUBLIC_PHONE=+1 213 267 4279
NEXT_PUBLIC_EMAIL=support@theusapublishers.com
